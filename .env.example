# Copy to .env.development for local dev
REACT_APP_API_URL=http://localhost:8000

# For Netlify / phone testing — set in Netlify UI or a local production build:
# Same Wi‑Fi (Mac LAN IP, not localhost):
# REACT_APP_API_URL=http://192.168.1.10:8000
# HTTPS tunnel (recommended for phone):
# REACT_APP_API_URL=https://xxxx.ngrok-free.app
